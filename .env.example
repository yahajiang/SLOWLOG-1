# Database - Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth (AUTH_SECRET 是 NextAuth 5 默认变量名，NEXTAUTH_SECRET 为兼容保留)
AUTH_SECRET=your-secure-secret-key
NEXTAUTH_URL=https://your-domain.vercel.app

# 播种用的管理员初始口令（prisma/seed.ts 必需；未设置则拒绝播种，源码里没有兜底明文）
# 只在首次建库时用到，登录后会被强制改密；改过密后这条可以删掉。
AUTH_DEFAULT_PASSWORD=change-me-before-seeding
# 可选：默认管理员邮箱（公开信息，README 里也写着；缺省 admin@slowlog.dev）
# AUTH_DEFAULT_EMAIL=admin@slowlog.dev

# Vercel Blob
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Android App · FCM（可选。未配置时发布通知自动跳过，不阻断发布）
# 值为 Firebase 服务账号 JSON 的一整行字符串（含引号内的 JSON）
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

